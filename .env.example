# Optional Supabase configuration. Leave blank for the synthetic local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Banking integration is disabled unless explicitly enabled server-side.
BANKING_INTEGRATION_ENABLED=false
BANKING_API_BASE_URL=https://api.example.invalid
BANKING_ACCESS_TOKEN=

# Public app URL for local/demo use only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
